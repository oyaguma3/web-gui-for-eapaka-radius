# web-gui-for-eapaka-radius の設定。このファイルを .env にコピーして書き換え、パーミッションを 600 にする。

# ---- 構成 ----

# 本PoCと同じホストで動かす場合は、共有ネットワークに参加する設定を重ねる（既定）。
# 別のホストで動かす場合は compose.yaml だけにする。
COMPOSE_FILE=compose.yaml:compose.eapaka-prov.yaml
# 同一ホストの本PoCが作る共有ネットワークの名前（本PoC側の .env の PROVISIONING_SHARED_NETWORK と同じにする）。
PROVISIONING_SHARED_NETWORK=eapaka-prov

# 本PoCの Provisioning API。同一ホストなら既定のままでよい。
# 別ホストの場合は、provisioning-api のサーバー証明書の SAN に入っている名前か IP アドレスで指定する。
EAPAKA_WEBGUI_ADMIN_URL=https://provisioning-api:9444/admin/v1
# BFF のクライアント証明書の秘密鍵を certs/admin-client.pem とは別のファイルにした場合だけ、コンテナ内のパスを指定する。
EAPAKA_WEBGUI_ADMIN_CLIENT_KEY=

# ---- 必須 ----

# BFF 専用の Valkey のパスワード（本PoC側の .env の VALKEY_PASSWORD とは別のもの）。
EAPAKA_WEBGUI_VALKEY_PASSWORD=change-me

# ---- ブラウザ向け HTTPS ----

# 公開するホスト側のアドレスとポート。VPN 側のアドレス（Tailscale なら 100.x.y.z）に限定する。
EAPAKA_WEBGUI_PUBLISH=127.0.0.1:8445

# 自己署名のサーバー証明書を初回起動時に自動生成するとき、SAN に入れるホスト名と IP アドレス。
# ブラウザで開くときの名前や IP アドレスをカンマ区切りで指定する。生成済みの証明書には反映されない。
EAPAKA_WEBGUI_TLS_HOSTS=localhost,127.0.0.1

# 持ち込みの証明書を使う場合は、certs/ に置いてコンテナ内のパス（/certs/...）を指定する。
# 空なら自己署名（/data/tls/ に自動生成）を使う。
EAPAKA_WEBGUI_TLS_CERT=
EAPAKA_WEBGUI_TLS_KEY=

# ---- その他 ----

TZ=Asia/Tokyo
EAPAKA_WEBGUI_LOG_LEVEL=info
